{
  "version": 1,
  "name": "se.ecms.live",
  "documents": [
    {
      "name": "Live post",
      "description": "A single post in a live blog. Live posts are addressed by their blog and a per-blog sequential id rather than by UUID or URI, and they carry no editorial context of their own: that belongs to the blog they are posted in.",
      "declares": "core/live-post",
      "content": [
        {"ref": "core://text"},
        {"ref": "core://image"},
        {"ref": "core://unordered-list"},
        {"ref": "core://ordered-list"}
      ],
      "meta": [
        {"ref": "core://note"}
      ],
      "links": [
        {"ref": "core://byline"},
        {"ref": "core://section"},
        {"ref": "core://story"},
        {"ref": "core://category"},
        {"ref": "core://person"},
        {"ref": "core://content-source"},
        {"ref": "core://content-source/document"}
      ]
    }
  ]
}
